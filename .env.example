# Copy to .env for local development. These are illustrative local values only.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://connecthub_app:replace_me@127.0.0.1:5432/connecthub_dev
TEST_DATABASE_URL=postgresql+psycopg://connecthub_app:replace_me@127.0.0.1:5432/connecthub_test
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:5173"]

# Generate a strong local secret; do not reuse this placeholder or commit a real value.
SESSION_COOKIE_NAME=connecthub_session
CSRF_COOKIE_NAME=connecthub_csrf
CSRF_SECRET=replace_with_a_strong_random_secret_in_task_3
SESSION_LIFETIME_DAYS=7
COOKIE_SECURE=false
RATE_LIMIT_WINDOW_SECONDS=60
REGISTRATION_RATE_LIMIT=10
LOGIN_RATE_LIMIT=20
ROOM_CREATE_RATE_LIMIT=20
MESSAGE_RATE_LIMIT=30
WEBSOCKET_CONNECTION_LIMIT=8
WEBSOCKET_QUEUE_SIZE=100
WEBSOCKET_FRAME_BYTES=16384
WEBSOCKET_MALFORMED_LIMIT=3
WEBSOCKET_IDLE_TIMEOUT_SECONDS=90
TYPING_THROTTLE_SECONDS=1.0
TYPING_EXPIRY_SECONDS=8
INVITATION_LIFETIME_DAYS=7

# Optional AI features. The application and core messaging remain available when
# these are disabled or no key is configured. Never commit a real provider key.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_TEXT_MODEL=gemini-3.5-flash-lite
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=768
AI_EMBEDDING_PROFILE_VERSION=retrieval-v1
AI_AUTO_EMBED_NEW_MESSAGES=false
AI_BACKFILL_ENABLED=false
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_SUMMARY_MESSAGES=100
AI_MAX_SUMMARY_CHARACTERS=24000
AI_SUMMARY_PROMPT_VERSION=summary-v1
AI_EMBEDDING_CANDIDATE_LIMIT=500
AI_EMBEDDING_MAX_ATTEMPTS=5
AI_WORKER_POLL_SECONDS=2
AI_STALE_RECOVERY_SECONDS=60

